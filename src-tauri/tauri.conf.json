{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RiftWatch",
  "version": "0.3.6",
  "identifier": "com.monocle.riftwatch",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RiftWatch",
        "width": 1000,
        "height": 720,
        "minWidth": 720,
        "minHeight": 460,
        "center": true,
        "decorations": true
      },
      {
        "label": "ticker",
        "title": "RiftWatch HUD",
        "url": "index.html?mode=detached",
        "width": 720,
        "height": 38,
        "minWidth": 450,
        "minHeight": 38,
        "maxHeight": 38,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": true,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
